rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function isVerified() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isEmailVerified == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can create their own user document during signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can read and update their own profile
      allow read, update: if isOwner(userId);
      
      // Only admins can delete users (implement admin check if needed)
      allow delete: if false;
    }
    
    // Email OTPs collection
    match /email_otps/{otpId} {
      // Allow creation for anyone (needed for signup before auth)
      allow create: if true;
      
      // Allow read and update for the email owner
      allow read, update: if request.auth.token.email == resource.data.email;
      
      // Allow delete for cleanup (can be restricted to Cloud Functions)
      allow delete: if true;
    }
    
    // ========== PROVIDER REGISTRATION RULES ==========
    
    // Provider drafts collection (registration progress)
    match /providerDrafts/{userId} {
      // Users can create and manage their own drafts
      allow create, read, update, delete: if isOwner(userId);
    }
    
    // Providers collection (approved providers)
    match /providers/{userId} {
      // Users can create their own provider profile during registration
      allow create: if isOwner(userId);
      
      // Users can read their own profile
      allow read: if isOwner(userId);
      
      // Users can update their own profile (limited fields)
      allow update: if isOwner(userId) && 
                       // Prevent users from changing verification status
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                         'isVerified', 
                         'verificationStatus', 
                         'approvedAt',
                         'rejectionReason'
                       ]);
      
      // Customers can read verified provider profiles
      allow read: if isAuthenticated() && resource.data.isVerified == true;
    }
    
    // ========== CHAT & MESSAGING RULES ==========
    
    // Conversations collection
    match /conversations/{conversationId} {
      // Users can create conversations they're part of
      allow create: if isAuthenticated() && 
                       request.auth.uid in request.resource.data.participantIds;
      
      // Users can read conversations they're part of
      allow read: if isAuthenticated() && 
                     request.auth.uid in resource.data.participantIds;
      
      // Users can update conversations they're part of (for typing indicators, etc.)
      allow update: if isAuthenticated() && 
                       request.auth.uid in resource.data.participantIds;
      
      // Users can delete (soft-delete) their own conversations
      allow delete: if isAuthenticated() && 
                       request.auth.uid in resource.data.participantIds;
      
      // Messages subcollection
      match /messages/{messageId} {
        // Users can create messages in conversations they're part of
        allow create: if isAuthenticated() && 
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Users can read messages in conversations they're part of
        allow read: if isAuthenticated() && 
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Users can update messages (for read receipts)
        allow update: if isAuthenticated() && 
                         request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // No deletion of individual messages
        allow delete: if false;
      }
    }
    
    // ========== SERVICE REQUESTS & BOOKINGS ==========
    
    // Service requests collection
    match /service_requests/{requestId} {
      // Only verified users can create service requests
      allow create: if isVerified();
      
      // Users can read their own requests
      allow read: if isVerified() && 
                     (resource.data.customerId == request.auth.uid || 
                      resource.data.providerId == request.auth.uid);
      
      // Users can update their own requests
      allow update: if isVerified() && 
                       (resource.data.customerId == request.auth.uid || 
                        resource.data.providerId == request.auth.uid);
      
      // No deletion allowed
      allow delete: if false;
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      allow create: if isVerified();
      allow read: if isVerified() && 
                     (resource.data.customerId == request.auth.uid || 
                      resource.data.providerId == request.auth.uid);
      allow update: if isVerified() && 
                       (resource.data.customerId == request.auth.uid || 
                        resource.data.providerId == request.auth.uid);
      allow delete: if false;
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow create: if isVerified();
      allow read: if true; // Reviews are public
      allow update: if isOwner(resource.data.userId);
      allow delete: if isOwner(resource.data.userId);
    }
    
    // Default: deny all access to other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
